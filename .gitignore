## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.usergz
*.usertasks
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leasePublic/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Tt]est[Rr]esults/

# Visual Studio 2015/2017 cache directory
.vs/
# Uncomment if power tools layout debugger is used
# *.layout.json

# Output cache
*.info

# MSTest test Results
[TestOutcome]
[TestRun]
[TestResults]
[TestResults]/*.trx
[TestResults]/*.xml

# NUnit
*.visualstate
*.suo.xslt

# Rider
.idea/

# Visual Studio Code
.vscode/

# Project-specific overrides
/SettleCore.Api/bin/
/SettleCore.Api/obj/
/SettleCore.Core/bin/
/SettleCore.Core/obj/
/SettleCore.Infrastructure/bin/
/SettleCore.Infrastructure/obj/
